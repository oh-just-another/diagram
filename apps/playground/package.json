{
  "name": "@oh-just-another/playground",
  "version": "0.0.0",
  "description": "Local playground / demo app for the diagram editor — boots the React <Editor> against in-tree workspace source.",
  "license": "MIT",
  "author": "Rustam Garifulin <rustam@n69.in>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oh-just-another/diagram.git",
    "directory": "apps/playground"
  },
  "homepage": "https://github.com/oh-just-another/diagram#readme",
  "bugs": "https://github.com/oh-just-another/diagram/issues",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:fresh": "vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "clean:cache": "rm -rf node_modules/.vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@oh-just-another/collab": "workspace:*",
    "@oh-just-another/editor": "workspace:*",
    "@oh-just-another/history": "workspace:*",
    "@oh-just-another/importers": "workspace:*",
    "@oh-just-another/network": "workspace:*",
    "@oh-just-another/raster-wasm": "workspace:*",
    "@oh-just-another/react-ui": "workspace:*",
    "@oh-just-another/renderer-canvas": "workspace:*",
    "@oh-just-another/renderer-core": "workspace:*",
    "@oh-just-another/renderer-svg": "workspace:*",
    "@oh-just-another/scene": "workspace:*",
    "@oh-just-another/serialization": "workspace:*",
    "@oh-just-another/state": "workspace:*",
    "@oh-just-another/templates": "workspace:*",
    "@oh-just-another/templates-jsx": "workspace:*",
    "@oh-just-another/text-wasm": "workspace:*",
    "@oh-just-another/tokens": "workspace:*",
    "@oh-just-another/types": "workspace:*",
    "@oh-just-another/versioning": "workspace:*",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3"
  }
}
